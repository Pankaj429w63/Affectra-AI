# Affectra AI — Environment Variable Template
#
# USAGE:
#   cp .env.example .env
#   # Edit .env with your real values
#   # NEVER commit .env to version control — it is git-ignored
#
# ----------------------------------------------------------------------------
# Model — Inference Artifacts (canonical paths — one definition only)
# ----------------------------------------------------------------------------

# Canonical path to the trained model artifact directory.
# After training, this contains: model_state.pt, model_config.json,
# emotion_labels.json, sentiment_labels.json, metrics.json, text_encoder/
MODEL_DIR=./models/affectra_multimodal/

# Filename of the fusion model weights file inside MODEL_DIR
MODEL_CHECKPOINT=model_state.pt

# ----------------------------------------------------------------------------
# Backend — FastAPI Server
# ----------------------------------------------------------------------------

# Host and port for the FastAPI server
API_HOST=0.0.0.0
API_PORT=8000

# Secret key for signing API tokens (change this in production!)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
API_SECRET_KEY=your-secret-key-here

# CORS: comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# ----------------------------------------------------------------------------
# Frontend — React + Vite
# ----------------------------------------------------------------------------

# URL of the FastAPI backend (used by Vite via import.meta.env.VITE_API_URL)
VITE_API_URL=http://localhost:8000

# ----------------------------------------------------------------------------
# Database & Auth — Supabase
# ----------------------------------------------------------------------------

# Supabase project URL (found in Supabase Dashboard → Settings → API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase public anon key (safe to use in frontend)
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase service role key (backend only — NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ----------------------------------------------------------------------------
# Training — Google Colab Only
# These variables are set INSIDE the Colab notebook, not on your local machine.
# They are listed here for reference only.
# ----------------------------------------------------------------------------

# Google Drive root path for Affectra AI training data (set inside Colab)
# COLAB_DRIVE_ROOT=/content/drive/MyDrive/AffectraAI

# MELD raw data directory inside Colab storage (set inside Colab)
# COLAB_DATA_DIR=/content/meld_data
