# Affectra AI — Environment Variable Template
#
# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control.
#
# Usage:
#   cp .env.example .env
#   # then edit .env with real values

# ---------------------------------------------------------------------------
# Model Configuration
# ---------------------------------------------------------------------------

# Directory where trained model checkpoints are stored
MODEL_DIR=./models/

# Name of the main inference checkpoint file
MODEL_CHECKPOINT=meld_fusion_model.pt

# ---------------------------------------------------------------------------
# Backend API
# ---------------------------------------------------------------------------

# Host and port for the FastAPI / Flask inference server
API_HOST=0.0.0.0
API_PORT=8000

# Secret key for API authentication (use a strong random string in production)
API_SECRET_KEY=your-secret-key-here

# ---------------------------------------------------------------------------
# Training
# ---------------------------------------------------------------------------

# Path to the MELD dataset root directory (never commit actual data)
MELD_DATASET_PATH=/path/to/meld/dataset

# Weights & Biases experiment tracking (optional)
WANDB_API_KEY=your-wandb-api-key-here
WANDB_PROJECT=affectra-ai
WANDB_ENTITY=your-wandb-username

# ---------------------------------------------------------------------------
# Frontend (if applicable)
# ---------------------------------------------------------------------------

# URL of the backend API that the frontend communicates with
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Database (if applicable)
# ---------------------------------------------------------------------------

DATABASE_URL=postgresql://user:password@localhost:5432/affectra
