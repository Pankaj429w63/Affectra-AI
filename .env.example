# Affectra AI — Environment Variable Template
#
# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control — it is git-ignored.
#
# Usage:
#   cp .env.example .env
#   # then edit .env with your actual values

# ---------------------------------------------------------------------------
# Model — Inference Artifacts
# ---------------------------------------------------------------------------

# Directory containing the trained model artifacts
# After training, this folder will contain:
#   model_state.pt, model_config.json, emotion_labels.json,
#   sentiment_labels.json, metrics.json, text_encoder/
MODEL_DIR=./models/affectra_multimodal/

# ---------------------------------------------------------------------------
# Backend — FastAPI Server
# ---------------------------------------------------------------------------

# Bind host for the FastAPI server
API_HOST=0.0.0.0

# Bind port for the FastAPI server
API_PORT=8000

# Secret key for API authentication
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
API_SECRET_KEY=your-secret-key-here

# CORS allowed origins (comma-separated, for the frontend URL)
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# ---------------------------------------------------------------------------
# Frontend — React + Vite
# ---------------------------------------------------------------------------

# URL of the FastAPI backend (used by the Vite frontend via import.meta.env)
VITE_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Database & Auth — Supabase
# ---------------------------------------------------------------------------

# Your Supabase project URL (found in Supabase dashboard → Settings → API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase public anon key (safe to use in frontend; row-level security protects data)
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase service role key (server-side only — keep secret, never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ---------------------------------------------------------------------------
# Training — Google Colab Only
# (These are set inside the Colab notebook, not locally)
# ---------------------------------------------------------------------------

# Path to MELD dataset root in Colab storage
# Set automatically by the Colab notebook after download
# MELD_DATA_DIR=/content/meld_data/MELD.Raw

# Google Drive path for saving feature caches (set inside Colab)
# DRIVE_CACHE_DIR=/content/drive/MyDrive/affectra/cache
