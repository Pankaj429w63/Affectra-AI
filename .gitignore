# =============================================================================
# Affectra AI — .gitignore
# Covers Python ML, Node/frontend, datasets, model weights, and secrets.
# =============================================================================

# ---------------------------------------------------------------------------
# SECRETS — never commit environment files with real values
# ---------------------------------------------------------------------------
.env
.envrc

# ---------------------------------------------------------------------------
# DATASETS & RAW DATA — never commit datasets or raw media to Git
# ---------------------------------------------------------------------------
data/
datasets/
*.mp4
*.avi
*.mov
*.mkv
*.wav
*.flac
*.csv
*.json
# Exception: allow small fixture/sample JSON files if added intentionally
!tests/**/*.json
!scripts/**/*.json

# ---------------------------------------------------------------------------
# MODEL WEIGHTS & CHECKPOINTS — large binary files, managed externally
# ---------------------------------------------------------------------------
models/*.pt
models/**/*.pt
models/*.pth
models/**/*.pth
models/*.onnx
models/**/*.onnx
models/*.bin
models/**/*.bin
models/*.safetensors
models/**/*.safetensors
# Keep .gitkeep files so empty directories are tracked
!models/.gitkeep
!models/**/.gitkeep
checkpoints/
*.ckpt
*.h5
*.pkl

# ---------------------------------------------------------------------------
# TRAINING OUTPUTS & EXPERIMENT LOGS
# ---------------------------------------------------------------------------
runs/
outputs/
lightning_logs/
wandb/
mlruns/
.neptune/
tensorboard_logs/

# ---------------------------------------------------------------------------
# PYTHON
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.pixi/
.pdm-python
.pdm-build/
__pypackages__/

# Testing & coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py.cover
.hypothesis/
.pytest_cache/
cover/

# Type checkers
.mypy_cache/
.dmypy.json
dmyds.json
.pyre/
.pytype/
.ruff_cache/

# Jupyter
.ipynb_checkpoints
profile_default/
ipython_config.py

# Misc Python tooling
*.sage.py
celerybeat-schedule
celerybeat.pid
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt
.spyderproject
.spyproject
.ropeproject
cython_debug/
.pypirc
marimo/_static/
marimo/_lsp/
__marimo__/

# ---------------------------------------------------------------------------
# NODE / FRONTEND
# ---------------------------------------------------------------------------
node_modules/
.next/
.nuxt/
dist/
build/
out/
.cache/
.parcel-cache/
.turbo/
.vercel/

# ---------------------------------------------------------------------------
# LOGS
# ---------------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------------------------------------------------------------------------
# EDITOR & OS
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# MISC
# ---------------------------------------------------------------------------
/site
.abstra/
.cursorignore
.cursorindexingignore
